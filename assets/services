/* ===========================================================
   CAUGIA CONSULTING — SERVICES PAGE
   Calm • Professional • Systematic
   =========================================================== */

.services-page {
  background-color: #f9fafc;
  color: #0b132b;
}

/* Basic layout hooks */

.site-header {
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  background: #ffffff;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 16px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: inherit;
}

.brand-mark {
  width: 32px;
  height: 32px;
}

.brand-name {
  font-weight: 600;
  font-size: 15px;
}

.nav-desktop a {
  margin-left: 20px;
  font-size: 14px;
  text-decoration: none;
  color: rgba(11, 19, 43, 0.75);
}

.nav-desktop a.active {
  color: #0046A5;
  font-weight: 600;
}

.page-main {
  padding-bottom: 64px;
}

/* Hero */

.page-hero {
  padding: 56px 16px 32px;
  background: #ffffff;
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}

.hero-inner {
  max-width: 920px;
}

.eyebrow {
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(11, 19, 43, 0.6);
  margin-bottom: 8px;
}

.page-hero h1 {
  font-size: clamp(32px, 3.4vw, 40px);
  line-height: 1.15;
  margin-bottom: 16px;
}

.hero-lead {
  font-size: 17px;
  line-height: 1.6;
  color: rgba(11, 19, 43, 0.85);
  margin-bottom: 8px;
  max-width: 640px;
}

.hero-sub {
  font-size: 15px;
  line-height: 1.6;
  color: rgba(11, 19, 43, 0.7);
  max-width: 640px;
}

/* Section headers */

.section-header {
  margin-bottom: 32px;
}

.section-header h2 {
  font-size: 24px;
  margin-bottom: 8px;
}

.section-header p {
  font-size: 15px;
  color: rgba(11, 19, 43, 0.7);
  max-width: 640px;
}

.section-header--narrow {
  max-width: 720px;
}

/* Services grid */

.service-ladder {
  padding: 40px 16px 24px;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

@media (max-width: 1100px) {
  .services-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .services-grid {
    grid-template-columns: 1fr;
  }
}

/* Service card base */

.service-card {
  background: #ffffff;
  border-radius: 14px;
  padding: 20px 18px 18px;
  border: 1px solid rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  height: 100%;
  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
}

.service-card-tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(11, 19, 43, 0.7);
  background: rgba(0, 0, 0, 0.03);
  margin-bottom: 10px;
}

.service-card-tag--primary {
  background: rgba(0, 70, 165, 0.08);
  color: #0046A5;
}

.service-card-title {
  font-size: 18px;
  margin-bottom: 8px;
}

.service-card-lead {
  font-size: 14px;
  color: rgba(11, 19, 43, 0.8);
  margin-bottom: 10px;
}

.service-card-body {
  font-size: 14px;
  color: rgba(11, 19, 43, 0.72);
  line-height: 1.6;
  margin-bottom: 12px;
}

.service-card-list {
  list-style: none;
  margin: 0 0 14px;
  padding: 0;
}

.service-card-list li {
  font-size: 13px;
  color: rgba(11, 19, 43, 0.8);
  line-height: 1.5;
  padding-left: 16px;
  position: relative;
  margin-bottom: 4px;
}

.service-card-list li::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: rgba(0, 70, 165, 0.4);
  position: absolute;
  left: 2px;
  top: 7px;
}

/* Card CTAs */

.service-card-cta {
  margin-top: auto;
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid rgba(0, 70, 165, 0.15);
  font-size: 13px;
  font-weight: 500;
  color: #0046A5;
  text-decoration: none;
  background: rgba(0, 70, 165, 0.04);
  transition: background 0.18s ease, border-color 0.18s ease, transform 0.12s ease;
}

.service-card-cta:hover {
  background: rgba(0, 70, 165, 0.08);
  border-color: rgba(0, 70, 165, 0.35);
  transform: translateY(-1px);
}

/* Card variations */

.service-card--score {
  border-color: rgba(0, 70, 165, 0.12);
}

.service-card--report {
  border-color: rgba(0, 18, 64, 0.16);
  background: linear-gradient(145deg, #ffffff, #f5f7fb);
}

.service-card--subscription {
  border-color: rgba(16, 185, 129, 0.18);
}

.service-card--marketplace {
  border-color: rgba(243, 108, 33, 0.18);
}

.service-card--consulting {
  border-color: rgba(0, 18, 64, 0.2);
  background: #0b132b;
  color: #f9fafb;
}

.service-card--consulting .service-card-tag {
  background: rgba(255, 255, 255, 0.08);
  color: #e5e7eb;
}

.service-card--consulting .service-card-lead,
.service-card--consulting .service-card-body,
.service-card--consulting .service-card-list li {
  color: #e5e7eb;
}

.service-card--consulting .service-card-list li::before {
  background: rgba(255, 255, 255, 0.7);
}

.service-card--consulting .service-card-cta {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.2);
}

.service-card--consulting .service-card-cta:hover {
  background: rgba(255, 255, 255, 0.12);
}

/* Subscription meta */

.service-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: baseline;
  font-size: 12px;
  color: rgba(11, 19, 43, 0.7);
  margin-bottom: 8px;
}

.service-card-price {
  font-weight: 600;
  color: #0046A5;
}

/* Flow section */

.services-flow {
  padding: 40px 16px 0;
}

.flow-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 32px;
}

@media (max-width: 1024px) {
  .flow-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .flow-grid {
    grid-template-columns: 1fr;
  }
}

.flow-step {
  background: #ffffff;
  border-radius: 12px;
  padding: 18px 16px;
  border: 1px solid rgba(0, 0, 0, 0.06);
}

.flow-step-label {
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(11, 19, 43, 0.55);
  margin-bottom: 6px;
}

.flow-step h3 {
  font-size: 16px;
  margin-bottom: 6px;
}

.flow-step p {
  font-size: 14px;
  color: rgba(11, 19, 43, 0.72);
  line-height: 1.6;
}

/* Flow CTA */

.flow-cta {
  margin-top: 8px;
  padding: 20px 18px;
  border-radius: 14px;
  background: #ffffff;
  border: 1px solid rgba(0, 70, 165, 0.18);
}

.flow-cta h3 {
  font-size: 17px;
  margin-bottom: 8px;
}

.flow-cta p {
  font-size: 14px;
  color: rgba(11, 19, 43, 0.75);
  margin-bottom: 14px;
}

.flow-cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.btn-primary,
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 9px 16px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
  cursor: pointer;
}

.btn-primary {
  background: #0046A5;
  color: #ffffff;
  border: 1px solid #0046A5;
}

.btn-primary:hover {
  background: #00357d;
}

.btn-secondary {
  background: #ffffff;
  color: #0046A5;
  border: 1px solid rgba(0, 70, 165, 0.3);
}

.btn-secondary:hover {
  background: rgba(0, 70, 165, 0.04);
}

/* Footer */

.site-footer {
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  padding: 16px 16px 24px;
  background: #ffffff;
}

.footer-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 13px;
  color: rgba(11, 19, 43, 0.7);
}

.footer-brand {
  font-weight: 500;
}
